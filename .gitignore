# hold plugin (infra/build_hold_plugin.sh clones BoltzExchange/hold into
# infra/hold-plugin/ and builds it there). We track our patched source
# files (encoder.rs, Cargo.toml, the vendored lightning-invoice crate)
# but not the cloned repo's own nested .git, Cargo build output, or the
# pinned protoc download — those are regenerated by the build script.
infra/hold-plugin/.git/
infra/hold-plugin/target/
infra/hold-plugin/vendor/*/target/
infra/.protoc/
